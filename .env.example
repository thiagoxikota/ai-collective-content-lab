# =====================================================================
# A chave e OPCIONAL.  /  The key is OPTIONAL.
# =====================================================================
# Posts (skill criar-post) nao precisam de chave: o render e local.
# A FAL_KEY so e usada para GERAR imagens/clips com IA (gerar-imagem, gerar-clip-ia).
# Pegue uma gratis em: https://fal.ai/dashboard/keys
#
# Posts need no key (local render). FAL_KEY is only for AI image/clip generation.
# Get one at: https://fal.ai/dashboard/keys

FAL_KEY=

# Provider ativo. Padrao: fal. Troca opcional (veja a tabela no README).
# Active provider. Default: fal. Optional swap (see the table in the README).
PROVIDER=fal

# ---------------------------------------------------------------------
# Alternativas (NAO precisa preencher para o caminho padrao com fal.ai).
# Alternatives (NOT needed for the default fal.ai path). Uncomment to use.
# ---------------------------------------------------------------------
# REPLICATE_API_TOKEN=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
